# Salin file ini menjadi `.env`, lalu isi nilainya.
# `.env` sudah masuk .gitignore — jangan pernah meng-commit nilai aslinya.

# Koneksi database.
# - Lokal  : jalankan `docker compose up -d db` dari root repo, pakai nilai di bawah.
# - Produksi: ambil dari Supabase -> Project Settings -> Database -> Connection string (URI).
DATABASE_URL="postgresql://pss:pss@localhost:5433/hulubalang"

# Kunci penandatangan sesi login. Buat string acak sendiri untuk tiap environment.
JWT_SECRET="ganti-dengan-string-acak-panjang"
JWT_EXPIRES_IN="7d"

# Supabase — dipakai untuk live tracking (Realtime).
# Ambil dari Supabase -> Project Settings -> API.
# Boleh dikosongkan saat pengembangan lokal.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
