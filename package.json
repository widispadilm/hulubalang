{
  "name": "hulubalang",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:user": "npm run dev --workspace=apps/web-user",
    "dev:admin": "npm run dev --workspace=apps/web-admin",
    "db:up": "docker compose up -d db"
  },
  "allowScripts": {
    "@nestjs/core@10.4.22": true,
    "@prisma/client@5.22.0": true,
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true
  }
}
