{
  "name": "hulubalang",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "start": "npm run start --workspace=apps/web",
    "prisma:generate": "npm run prisma:generate --workspace=apps/web",
    "prisma:push": "npm run prisma:push --workspace=apps/web"
  },
  "allowScripts": {
    "@nestjs/core@10.4.22": true,
    "@prisma/client@5.22.0": true,
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true
  },
  "packageManager": "npm@10.9.0",
  "devDependencies": {
    "turbo": "^2.10.12"
  }
}
